# ── Merkado De 'Colon ─────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust for your machine.

# HTTP + Socket.IO port
PORT=4000
NODE_ENV=development

# MongoDB (optional for local demo, required for persistent online play)
# Local:  mongodb://127.0.0.1:27017/merkado_de_colon
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/merkado_de_colon
MONGODB_URI=

# Allowed origins in production (comma separated). Dev accepts localhost/LAN.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4000
